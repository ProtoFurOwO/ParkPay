# ========================================
# CONFIGURACIÓN SUPABASE (CLOUD)
# ========================================
DATABASE_URL=postgresql://usuario:password@host:puerto/database

# Configuración individual (alternativa)
DB_HOST=tu-host.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=tu_usuario
DB_PASSWORD=tu_password

# Puerto del servidor
PORT=3000

# ========================================
# SENDGRID - EMAIL SERVICE (RECUPERACIÓN DE CONTRASEÑA)
# ========================================
# 1. Crea cuenta gratis en: https://sendgrid.com (100 emails/día)
# 2. Verifica tu email/dominio en Settings > Sender Authentication
# 3. Crea API Key en Settings > API Keys con permisos "Mail Send"
# 4. Copia el API Key aquí:
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email verificado que aparecerá como remitente
SENDGRID_FROM_EMAIL=noreply@tudominio.com

# NOTA: Sin SENDGRID_API_KEY el sistema funciona en modo desarrollo
# mostrando los códigos en consola del servidor (para pruebas locales)
